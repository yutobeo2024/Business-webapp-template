# Môi trường dev. Copy thành .env (không commit).
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
PORT=3000
APP_ORIGIN=http://localhost:5173
# Tên DB và chỉ số Redis riêng cho từng dự án (installer đặt theo tên thư mục): nhiều dự án dùng chung Postgres/Redis
# của `pnpm dev:services` mà không đụng dữ liệu, hàng đợi của nhau. Tạo/dựng lại DB: `pnpm db:reset-local [dev]`.
DATABASE_URL=postgresql://app:app@localhost:5432/app_dev
REDIS_URL=redis://localhost:6379/1
# Test tích hợp (`pnpm test:integration`): tên DB phải kết thúc bằng _test, Redis chỉ số khác 0 và khác dev.
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app_test
TEST_REDIS_URL=redis://localhost:6379/15
SESSION_TTL_HOURS=12
SESSION_MAX_DAYS=7
LOG_LEVEL=debug
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=doi-mat-khau-nay-ngay
# Tệp đính kèm và tệp xuất (ADR-0005). Tương đối = so với gốc repo.
STORAGE_DRIVER=local
STORAGE_DIR=.data/files
FILE_MAX_MB=10
# Thông báo qua email (spec 003). Dev: Mailpit của pnpm dev:services, xem thư ở http://localhost:8025.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Hệ thống quản lý <no-reply@localhost>"

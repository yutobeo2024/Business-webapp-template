{
  "name": "app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "playwright test",
    "verify:quick": "pnpm lint && pnpm typecheck && turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @app/shared build && pnpm --filter @app/db run generate",
    "db:migrate": "pnpm --filter @app/db run migrate",
    "db:seed": "pnpm --filter @app/api run seed",
    "dev:services": "docker compose -f infra/compose.dev.yml up -d",
    "claude:selftest": "node .claude/hooks/selftest.mjs",
    "sample:remove": "node scripts/remove-sample.mjs",
    "db:reset-local": "node scripts/db-reset-local.mjs",
    "project:setup": "node scripts/project-setup.mjs"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "exceljs": "4.4.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "turbo": "2.11.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
